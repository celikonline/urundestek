# Yerel geliştirme. Docker Compose APP_ENV=production değerini zorunlu kılar.
APP_ENV=development
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:5173
RUN_REMINDER_WORKER=true
# Yerelde DATABASE_URL verilmezse data/support.db kullanılır.
# DATABASE_URL=postgresql+psycopg://support:your-password@localhost:5432/support
# SenseİK URL'si /api ile bitmeli; /v1/identity/me sunucu tarafında eklenir.
SENSEIK_API_URL=
SENSEIK_WEB_ORIGIN=
# Üretim ilk yönetici kaydı. En az 12 karakter; gerçek değerleri Git'e eklemeyin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Destek Yöneticisi
POSTGRES_PASSWORD=
