# Yerel geliştirme. Docker Compose APP_ENV=production değerini zorunlu kılar.
APP_ENV=development
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:5173
RUN_REMINDER_WORKER=true
# Arka plan işçisi döngü aralığı (saniye): hatırlatma, asistan, e-posta.
WORKER_INTERVAL_SECONDS=10
# Yerelde DATABASE_URL verilmezse data/support.db kullanılır.
# DATABASE_URL=postgresql+psycopg://support:your-password@localhost:5432/support
# SenseİK URL'si /api ile bitmeli; /v1/identity/me sunucu tarafında eklenir.
SENSEIK_API_URL=
SENSEIK_WEB_ORIGIN=
# Üretim ilk yönetici kaydı. En az 12 karakter; gerçek değerleri Git'e eklemeyin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Destek Yöneticisi
POSTGRES_PASSWORD=

# E-posta bildirimleri. SMTP_HOST ve MAIL_FROM boşsa özellik kapalıdır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_TLS=starttls
MAIL_FROM=

# SenseİK Asistan (Claude). Anahtar yoksa asistan kapalıdır.
ANTHROPIC_API_KEY=
# off | draft (yalnız ekibe taslak) | auto (müşteriye otomatik yanıt). Firma bazında değiştirilebilir.
AI_MODE=draft
AI_MODEL=claude-opus-5-5
AI_MAX_AUTO_REPLIES=3
AI_MIN_CONFIDENCE=0.7
AI_KNOWLEDGE_FILE=docs/ai-bilgi-bankasi.md
# Çözülen talep bu kadar gün hareketsiz kalırsa otomatik kapanır (0 = kapalı).
AUTO_CLOSE_DAYS=7

# BGYS: hesap kilidi, boşta kalma ve saklama süreleri (gün; 0 = süresiz / kapalı).
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
STAFF_IDLE_MINUTES=60
AUDIT_RETENTION_DAYS=730
NOTIFICATION_RETENTION_DAYS=180
MAIL_RETENTION_DAYS=30
CLOSED_TICKET_RETENTION_DAYS=0
